# This is the build file for project "mesa"
# It is autogenerated by the Meson build system.
# Do not edit by hand.

ninja_required_version = 1.8.2

# Rules for module scanning.

# Rules for compiling.

rule c_COMPILER
 command = /ninja-to-soong/ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android35-clang $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C object $out

rule cpp_COMPILER
 command = /ninja-to-soong/ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android35-clang++ $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C++ object $out

# Rules for linking.

rule STATIC_LINKER
 command = rm -f $out && /ninja-to-soong/ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar $LINK_ARGS $out $in
 description = Linking static target $out

rule c_LINKER
 command = /ninja-to-soong/ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android35-clang $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule cpp_LINKER
 command = /ninja-to-soong/ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android35-clang++ $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule SHSYM
 command = /usr/local/bin/meson --internal symbolextractor /ninja-to-soong/src $in $IMPLIB $out $CROSS
 description = Generating symbol file $out
 restat = 1

# Other rules

rule CUSTOM_COMMAND
 command = $COMMAND
 description = $DESC
 restat = 1

rule REGENERATE_BUILD
 command = /usr/local/bin/meson --internal regenerate /ninja-to-soong/src .
 description = Regenerating build files
 generator = 1

# Phony build target, always out of date

build PHONY: phony 

