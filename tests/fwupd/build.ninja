# This is the build file for project "fwupd"
# It is autogenerated by the Meson build system.
# Do not edit by hand.

ninja_required_version = 1.8.2

# Rules for module scanning.

# Rules for compiling.

rule c_COMPILER
 command = /tmp/ninja-to-soong/android-ndk-r27c/toolchains/llvm/prebuilt/linux-x86_64/bin/x86_64-linux-android35-clang $ARGS -MD -MQ $out -MF $DEPFILE -o $out -c $in
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = Compiling C object $out

# Rules for linking.

rule STATIC_LINKER
 command = rm -f $out && /tmp/ninja-to-soong/android-ndk-r27c/toolchains/llvm/prebuilt/linux-x86_64/bin/llvm-ar $LINK_ARGS $out $in
 description = Linking static target $out

rule c_LINKER
 command = /tmp/ninja-to-soong/android-ndk-r27c/toolchains/llvm/prebuilt/linux-x86_64/bin/x86_64-linux-android35-clang $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule c_LINKER_RSP
 command = /tmp/ninja-to-soong/android-ndk-r27c/toolchains/llvm/prebuilt/linux-x86_64/bin/x86_64-linux-android35-clang @$out.rsp
 rspfile = $out.rsp
 rspfile_content = $ARGS -o $out $in $LINK_ARGS
 description = Linking target $out

rule SHSYM
 command = /usr/bin/meson --internal symbolextractor /tmp/ninja-to-soong/fwupd $in $IMPLIB $out $CROSS
 description = Generating symbol file $out
 restat = 1

# Other rules

rule CUSTOM_COMMAND
 command = $COMMAND
 description = $DESC
 restat = 1

rule CUSTOM_COMMAND_DEP
 command = $COMMAND
 deps = gcc
 depfile = $DEPFILE_UNQUOTED
 description = $DESC
 restat = 1

rule REGENERATE_BUILD
 command = /usr/bin/meson --internal regenerate /ninja-to-soong-fwupd .
 description = Regenerating build files
 generator = 1

# Phony build target, always out of date

build PHONY: phony 

